# Домен сайта (A-запись должна указывать на IP сервера), например dronchik.ru
DOMAIN=

# Необязательно: подложка MapTiler. Без ключа карта рисует собственную подложку
# (границы регионов и районов, подписи городов) и не зависит от внешних сервисов.
# Ключ MapTiler (https://cloud.maptiler.com/account/keys/).
# Ключ виден в браузере — ограничьте его своим доменом в настройках MapTiler (Allowed HTTP origins).
MAPTILER_KEY=
# Стиль подложки: dataviz-dark, streets-v2-dark, backdrop-dark, basic-v2-dark ...
MAPTILER_STYLE=dataviz-dark

# Telegram (https://my.telegram.org → API development tools). Затем: python -m app.telegram_login
TG_API_ID=
TG_API_HASH=
# TG_SESSION=data/telegram
# TG_CHANNELS_FILE=channels.json

# DEMO=auto — демо, только если не задан ни один канал; 1 — всегда демо; 0 — никогда
DEMO=auto

# Как часто перечитывать каналы через t.me/s (без Telegram-аккаунта), секунды
POLL_INTERVAL=30

# Токен для POST /api/ingest (подача сообщений из других источников). Пусто — эндпоинт выключен.
INGEST_TOKEN=

# Сколько часов истории перечитывать из базы при рестарте
HISTORY_HOURS=3
